# Use the same production MongoDB URI, stored only on the separate backup worker.
MONGO_URI=mongodb+srv://REPLACE_WITH_BACKUP_USER_AND_PASSWORD@REPLACE_WITH_CLUSTER/REPLACE_WITH_DATABASE

# These must be persistent paths outside the project on the backup host.
# Example Windows paths:
BACKUP_DIR=D:\MIU-Clubs-Backups
EXCEL_BACKUP_FILE=D:\MIU-Clubs-Backups\miu project new.xlsx

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key separate from the backup files. Losing it makes encrypted backups unreadable.
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
