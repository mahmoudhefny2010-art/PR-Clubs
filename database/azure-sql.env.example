# Copy the selected profile into the protected deployment environment.
# Activate only after migration/validation on this Azure database passes.
DATABASE_PROVIDER=azuresql
AZURE_SQL_HOST=YOUR_SERVER.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=YOUR_DATABASE_NAME

# SQL login:
AZURE_SQL_AUTH_MODE=sql
AZURE_SQL_USER=YOUR_DATABASE_USERNAME
AZURE_SQL_PASSWORD=YOUR_DATABASE_PASSWORD

# Alternatively use Microsoft Entra credentials/managed identity available to
# this runtime. Entra database permissions must be provisioned separately.
# AZURE_SQL_AUTH_MODE=entra-default
# AZURE_SQL_CLIENT_ID=YOUR_USER_ASSIGNED_MANAGED_IDENTITY_CLIENT_ID

# Alternatively use an Entra service principal (store its secret securely):
# AZURE_SQL_AUTH_MODE=entra-service-principal
# AZURE_SQL_CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
# AZURE_SQL_TENANT_ID=YOUR_DIRECTORY_TENANT_ID
# AZURE_SQL_CLIENT_SECRET=YOUR_APPLICATION_CLIENT_SECRET

AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
AZURE_SQL_POOL_MAX=5
AZURE_SQL_CONNECTION_TIMEOUT_MS=30000
AZURE_SQL_REQUEST_TIMEOUT_MS=15000

# Migration CLI targets this exact isolated Azure SQL database.
AZURE_SQL_MIGRATION_TARGET_DATABASE=YOUR_DATABASE_NAME
# Shared SQL migration command; explicit empty-target creation only:
# ALLOW_SQLSERVER_SCHEMA=CREATE_EMPTY_TARGET
# SQLSERVER_INTEGRATION_TESTS=true
# Production only after recovery, migration and feature QA:
# AZURE_SQL_CUTOVER_APPROVED=true

# Source/export/report paths use the same MIGRATION_* settings documented
# in README.md. Keep artifacts private and outside this repository.
