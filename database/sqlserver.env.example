# SQL Server profile. Activate only after migration/staging validation.
# Use mongodb to keep the current source; use azuresql with azure-sql.env.example.
DATABASE_PROVIDER=sqlserver
SQLSERVER_HOST=YOUR_SQL_SERVER_HOST
SQLSERVER_PORT=1433
# For a named instance, remove SQLSERVER_PORT and configure separately:
# SQLSERVER_INSTANCE=SQLEXPRESS
SQLSERVER_DATABASE=YOUR_DATABASE_NAME
SQLSERVER_AUTH_MODE=sql
SQLSERVER_USER=YOUR_DATABASE_USERNAME
SQLSERVER_PASSWORD=YOUR_DATABASE_PASSWORD
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
SQLSERVER_POOL_MAX=5
SQLSERVER_CONNECTION_TIMEOUT_MS=8000
SQLSERVER_REQUEST_TIMEOUT_MS=15000

# Migration CLI only: a protected isolated database, never the production source.
SQLSERVER_MIGRATION_TARGET_DATABASE=YOUR_DATABASE_NAME
# Set only for explicit schema creation in an empty isolated target:
# ALLOW_SQLSERVER_SCHEMA=CREATE_EMPTY_TARGET
# Set outside this project on protected/encrypted persistent storage:
# MIGRATION_EXPORT_FILE=D:\PrivateMigration\source.ndjson
# MIGRATION_REPORT_FILE=D:\PrivateMigration\report-unique-name.json
# MIGRATION_BACKUP_EVIDENCE_FILE=D:\PrivateMigration\verified-backup.json
# MIGRATION_SOURCE_URI=READ_ONLY_URI_FOR_THE_VERIFIED_ISOLATED_MONGO_RESTORE
# MIGRATION_SOURCE_IS_ISOLATED_RESTORE=true
# Set only for real integration tests against the isolated SQL target:
# SQLSERVER_INTEGRATION_TESTS=true
# Production deployment only, after SQL feature QA, backup and final reconciliation:
# SQLSERVER_CUTOVER_APPROVED=true

# Optional GET response comparison between two isolated staging applications:
# API_PARITY_STAGING_CONFIRMED=true
# API_PARITY_MONGO_ORIGIN=http://127.0.0.1:1111
# API_PARITY_SQL_ORIGIN=http://127.0.0.1:1112
# API_PARITY_CASES_FILE=D:\PrivateMigration\api-cases.json
# API_PARITY_REPORT_FILE=D:\PrivateMigration\api-parity-report-unique-name.json
# API_PARITY_MONGO_COOKIE=PROTECTED_STAGING_SESSION_COOKIE
# API_PARITY_SQL_COOKIE=PROTECTED_STAGING_SESSION_COOKIE
